# Copy to .env (or pass with `docker run -e ...`). The UI also accepts the key in the sidebar.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint; leave empty for api.openai.com
OPENAI_BASE_URL=
MODEL=gpt-4.1-mini
# Optional per-call overrides
# EXTRACT_MODEL=
# RESPONSE_MODEL=
# Deadlines are judged against this date. Remove to use the real date.
DEMO_TODAY=2026-02-15
DATA_DIR=insurance_claims/fixtures
